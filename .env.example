# ================= 数据服务（可选，不填则自动使用「免费/演示」数据源）=================

# 高德地图 Web 服务 Key（强烈推荐：覆盖 POI 景点/酒店搜索、驾车/步行/公交路线，中文数据最佳）
# 申请：https://console.amap.com/dev/key/app —— 创建应用 → 添加 Key → 服务平台勾选「Web服务」
# 免费额度：约 2000 次/天（个人测试足够）
AMAP_KEY=

# OpenWeatherMap Key（可选天气源；不填则默认使用无需 Key 的 Open-Meteo）
# 申请：https://home.openweathermap.org/api_keys
OPENWEATHERMAP_KEY=

# ================= 默认 LLM（可选；也可在 Web 界面按次输入，Key 仅用于本次请求、不落盘）=================
# 可选值：openai | anthropic | azure_openai | zhipu | qianfan
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_API_KEY=
# 仅在使用 OpenAI 兼容网关/自部署时需要（如智谱 https://open.bigmodel.cn/api/paas/v4）
DEFAULT_LLM_BASE_URL=
DEFAULT_LLM_MODEL=

# ================= 服务 =================
# 相同请求结果缓存时长（秒）
CACHE_TTL_SECONDS=3600
# 允许跨域来源，逗号分隔；默认 * 允许全部（本地/局域网开发）
CORS_ORIGINS=*
